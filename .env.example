# MT5 Connection Settings
MT5_ACCOUNT=12345678
MT5_PASSWORD=your_password_here
MT5_SERVER=YourBroker-Demo

# Trading Settings
SYMBOL=XAUUSD
TIMEFRAME=M1
MAGIC_NUMBER=123456

# Risk Management
RISK_MODE=moderate  # conservative, moderate, aggressive
MAX_DAILY_LOSS=1000  # USD
MAX_DRAWDOWN_PERCENT=10.0
AUTO_STOP_ON_DRAWDOWN=true

# ML Models
MODEL_PATH=models_trained/
RETRAIN_INTERVAL_HOURS=168  # Weekly

# Dashboard Settings
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
WEBSOCKET_PORT=8001

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=logs/trading.log

# Database
DB_PATH=data/trading.db
REDIS_HOST=localhost
REDIS_PORT=6379
USE_REDIS=false

# Performance
CPU_AFFINITY=0,1,2,3  # Core IDs to pin threads
JIT_ENABLED=true
OPTIMIZATION_LEVEL=3

# Backtesting
BACKTEST_START_DATE=2023-01-01
BACKTEST_END_DATE=2024-01-01
BACKTEST_INITIAL_CAPITAL=10000

# Alerts (optional)
ENABLE_EMAIL_ALERTS=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
ALERT_EMAIL=alerts@example.com

# System
PAPER_TRADING=true  # Set to false for live trading
TIMEZONE=UTC
